# ============================================================================
# CardVault configuration. Copy to .env and fill in the blanks.
# The same file serves local development (pnpm dev:*) and docker compose.
# ============================================================================

# ---- Required for docker compose -------------------------------------------
POSTGRES_PASSWORD=
# Long random string (32+ chars). Generate: openssl rand -base64 48
SESSION_SECRET=
# First administrator, created on first `pnpm user:create --bootstrap`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Network ---------------------------------------------------------------
# Port the web UI listens on (http://<server>:8080)
WEB_PORT=8080
# Extra browser addresses allowed by the same-origin (CSRF) check, comma-separated.
# The address the browser actually used is accepted automatically; list others
# here only if requests arrive through a proxy that rewrites the Host header.
WEB_ORIGIN=http://cardvault.local:8080
# Hostname for the optional HTTPS profile (Caddy)
CARDVAULT_HOST=cardvault.home
# Set true when served over HTTPS
COOKIE_SECURE=false

# ---- Local development only (compose sets these itself) --------------------
NODE_ENV=development
DATABASE_URL=postgres://cardvault:cardvault@localhost:5432/cardvault
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
API_PORT=3000

# ---- Data providers (all optional) -----------------------------------------
# Pokémon TCG API — works without a key at a lower rate. Deprecated: keys stop
# working after 2027-03-01; TCGdex (no key) remains the primary Pokémon source.
POKEMONTCG_API_KEY=
# eBay Browse API (developer.ebay.com → application keys, Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
CRAWLER_USER_AGENT=CardVault/0.1 (self-hosted personal collection tool)

# ---- Behaviour --------------------------------------------------------------
# "Scan once, research forever": re-research owned cards this often
RESEARCH_REFRESH_HOURS=24
WORKER_CONCURRENCY=2
# Load 8 demo cards with synthetic price history (source "demo") on startup
SEED_DEMO=false

# ---- Backups (docker compose --profile backup) ------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# ---- CardVault-Vision (optional model factory) ------------------------------
# CardVault runs its exported ONNX bundles itself (no Python needed). Set these
# only to train with its `vision` CLI from OCR Lab, or to read exports from a
# folder other than $STORAGE_DIR/ocr/vision/exports.
# Checkout of github.com/iant89/CardVault-Vision (found in vendor/ or beside the
# repository automatically).
CARDVAULT_VISION_DIR=
# Extra folders to scan for exports (<task>/<version>/), ':'-separated.
VISION_MODELS_DIR=

# ---- Developer tools (admins only, Developer menu in the nav bar) -----------
# Set to false to hide the menu and disable its endpoints.
DEV_TOOLS=true
# TCGdex Harvester: started on demand, listens on 127.0.0.1 only and is reached
# through CardVault. Downloads go to $STORAGE_DIR/tcgdex-data unless set.
HARVESTER_PORT=4777
HARVESTER_OUT_DIR=
# OCR trainer (Developer → OCR Lab → Models → Train): the Python interpreter
# with torch and pillow installed (see tools/ocr-trainer/README.md), and where
# the trainer lives. Both are found automatically (the trainer venv, then
# python3), and “Set up the OCR trainer” in OCR Lab installs the interpreter —
# nothing needs setting here on a normal install. scripts/ocr-python.sh does
# the same from a shell (the native installer runs it once).
OCR_TRAIN_PYTHON=
OCR_TRAIN_DIR=
# Where that setup keeps the trainer's Python (default: <STORAGE_DIR>/ocr/venv),
# and where it downloads the CPU PyTorch wheel from:
# OCR_TRAIN_VENV=/opt/cardvault/storage/ocr/venv
# OCR_TRAIN_TORCH_INDEX=https://download.pytorch.org/whl/cpu

# ---- OCR model safety (Developer → OCR Lab) -----------------------------------
# A model must read this many confirmed lines in a live trial before it can be
# promoted (0 = no trial required).
OCR_TRIAL_MIN_LINES=40
# Once active, a model is compared with the previous engine every 15 minutes and
# rolled back automatically if accuracy drops by more than OCR_WATCH_MAX_DROP or
# the share of scans needing manual review rises by more than
# OCR_WATCH_MAX_REVIEW_RISE. It is only judged once each side has this much data:
OCR_WATCH_MIN_LINES=30
OCR_WATCH_MIN_SCANS=20
OCR_WATCH_MAX_DROP=0.05
OCR_WATCH_MAX_REVIEW_RISE=0.15
