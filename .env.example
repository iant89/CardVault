# ============================================================================
# CardVault configuration. Copy to .env and fill in the blanks.
# The same file serves local development (pnpm dev:*) and docker compose.
# ============================================================================

# ---- Required for docker compose -------------------------------------------
POSTGRES_PASSWORD=
# Long random string (32+ chars). Generate: openssl rand -base64 48
SESSION_SECRET=
# First administrator, created on first `pnpm user:create --bootstrap`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Network ---------------------------------------------------------------
# Port the web UI listens on (http://<server>:8080)
WEB_PORT=8080
# Exact origin family members use in the browser (CSRF origin check)
WEB_ORIGIN=http://cardvault.local:8080
# Hostname for the optional HTTPS profile (Caddy)
CARDVAULT_HOST=cardvault.home
# Set true when served over HTTPS
COOKIE_SECURE=false

# ---- Local development only (compose sets these itself) --------------------
NODE_ENV=development
DATABASE_URL=postgres://cardvault:cardvault@localhost:5432/cardvault
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
API_PORT=3000

# ---- Data providers (all optional) -----------------------------------------
# Pokémon TCG API — works without a key at a lower rate. Deprecated: keys stop
# working after 2027-03-01; TCGdex (no key) remains the primary Pokémon source.
POKEMONTCG_API_KEY=
# eBay Browse API (developer.ebay.com → application keys, Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
CRAWLER_USER_AGENT=CardVault/0.1 (self-hosted personal collection tool)

# ---- Behaviour --------------------------------------------------------------
# "Scan once, research forever": re-research owned cards this often
RESEARCH_REFRESH_HOURS=24
WORKER_CONCURRENCY=2
# Load 8 demo cards with synthetic price history (source "demo") on startup
SEED_DEMO=false

# ---- Backups (docker compose --profile backup) ------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
